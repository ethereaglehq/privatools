# Python
__pycache__/
*.py[cod]
*.egg-info/
.env
venv/
.venv/

# Node / Frontend
node_modules/
frontend/dist/

# Temp files
*.tmp
temp_files/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Test output
test_log.txt
test_results.json
temp/
deep_*
test_all_tools.py
lo_input_*.pdf

# SSH keys and other secrets — never commit these
.secrets/

# Durable app state (accounts, API keys). Created at runtime; never committed.
/data/

# Local agent state. Holds a per-machine command allowlist that quotes real
# host paths and SSH invocations — machine-local, never shared.
.claude/settings.local.json

# Generated browser model assets (pinned/prepared by frontend build hooks).
/frontend/public/models/*.onnx
/frontend/public/models/*.wasm
/frontend/public/models/*.mjs
/frontend/public/models/asset-manifest.json

# Private local cleanup archives and generated compiler state.
/.local-archive/
/frontend/*.tsbuildinfo

# Deploy state that auto-deploy.sh and rollout.sh keep in the VM checkout:
# last deployed and failed revisions, the replaced release, degraded backoff.
/.privatools-auto-deploy.*
/.privatools-deploy.*
