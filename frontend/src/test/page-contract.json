      "rotate-270": { "mediabox": [0, 0, 612, 792], "rotate": 270, "shown": [792, 612], "unrotated": { "x": 498, "y": 60, "width": 34, "height": 320 } },
      "cropped": { "mediabox": [0, 0, 612, 792], "cropbox": [36, 48, 576, 744], "rotate": 0, "shown": [540, 696], "unrotated": { "x": 60, "y": 80, "width": 320, "height": 34 } },
      "cropped-rotate-90": { "mediabox": [0, 0, 612, 792], "cropbox": [36, 48, 576, 744], "rotate": 90, "shown": [696, 540], "unrotated": { "x": 80, "y": 316, "width": 34, "height": 320 } },
      "cropped-rotate-270": { "mediabox": [0, 0, 612, 792], "cropbox": [36, 48, 576, 744], "rotate": 270, "shown": [696, 540], "unrotated": { "x": 426, "y": 60, "width": 34, "height": 320 } },
      "offset-rotate-180": { "mediabox": [100, 50, 712, 842], "rotate": 180, "shown": [612, 792], "unrotated": { "x": 232, "y": 678, "width": 320, "height": 34 } },
      "rotate-minus-90": { "mediabox": [0, 0, 612, 792], "rotate": -90, "shown_rotate": 270, "shown": [792, 612], "unrotated": { "x": 498, "y": 60, "width": 34, "height": 320 } },
      "cropped-rotate-450": { "mediabox": [0, 0, 612, 792], "cropbox": [36, 48, 576, 744], "rotate": 450, "shown_rotate": 90, "shown": [696, 540], "unrotated": { "x": 80, "y": 316, "width": 34, "height": 320 } },
      "rotate-80": { "mediabox": [0, 0, 612, 792], "rotate": 80, "shown_rotate": 0, "shown": [612, 792], "unrotated": { "x": 60, "y": 80, "width": 320, "height": 34 } },
