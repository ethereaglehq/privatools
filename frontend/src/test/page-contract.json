  "turned": {
    "about": "Where a box drawn on the preview goes, on pages stored turned (/Rotate) or whose visible area (the CropBox, else the MediaBox) does not start at 0,0. `drawn` is the box the visitor drags on the preview, in points from the top-left corner of the page as shown; `shown` is the size pdf.js shows the page at. `rotate` is /Rotate as the file writes it, on the page or, with `inherited`, on the page tree; where pdf.js reads it otherwise (-90 as 270, 450 as 90, 80 as 0), `shown_rotate` says how it reads it, and the routes must read it the same way. A tool's `frame` says what its route measures in: `unrotated` routes take the box from the top-left corner of the visible area before /Rotate, which for each page is `unrotated` below; `shown-from-bottom` routes take the drawn box measured from the bottom-left corner of the page as shown. page-contract.test.tsx draws `drawn` on each page with real pdf.js and expects those values in the request; test_page_contract.py builds the same pages with text under the box, sends those values through the real routes and checks that the change lands on the drawn box as the page is shown, and nowhere else.",
    "drawn": { "x": 60, "y": 80, "width": 320, "height": 34 },
    "crop-pdf": { "about": "Crop's page sends the margins around the drawn area to keep, as shown, and asks the route to measure them there.", "endpoint": "/crop", "margins_from": "shown" },
    "pages": {
      "rotate-90": { "mediabox": [0, 0, 612, 792], "rotate": 90, "shown": [792, 612], "unrotated": { "x": 80, "y": 412, "width": 34, "height": 320 } },
