# Copy to frontend/.env.local. These VITE_ values are public build configuration.
VITE_AUTH_PROVIDER=clerk
# Use a Clerk DEVELOPMENT publishable key for localhost (pk_test_...).
# A production key is domain-restricted and cannot authenticate this preview.
VITE_CLERK_PUBLISHABLE_KEY=
# List only social connections enabled in that Clerk instance.
# Google and GitHub are enabled in the verified PrivaTools instances.
# Override this list for a different Clerk instance.
VITE_CLERK_SOCIAL_PROVIDERS=google,github
# Match these to the enabled Clerk dashboard settings.
VITE_CLERK_USERNAME_ENABLED=true
VITE_CLERK_PASSKEYS_ENABLED=true
# Password minimum is 12, with breached-password blocking on and no composition rules.
# Existing self-hosted installations may explicitly opt into native accounts:
# VITE_AUTH_PROVIDER=local
