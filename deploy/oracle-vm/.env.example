# Compose substitution template for /home/ubuntu/privatools/.env.
# No real secrets or production values belong in this committed example.
# Variables not referenced by docker-compose.yml are NOT passed to containers.
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
# Use only connections actually enabled and tested in the production instance.
VITE_AUTH_PROVIDER=clerk
VITE_CLERK_SOCIAL_PROVIDERS=google,github
VITE_CLERK_USERNAME_ENABLED=true
VITE_CLERK_PASSKEYS_ENABLED=true
# Empty keeps processing on the page origin. Preserve the existing production
# setting until DNS, certificates, upload checks and rollback are reviewed.
PUBLIC_API_BASE_URL=
# Measurement ID is public. Browser collection stays disabled until remote
# Google tag settings are verified; once enabled it is on for every visitor.
GA4_MEASUREMENT_ID=
GA_BROWSER_TAG_ENABLED=false
# Exact reviewed image digest is supplied by the release process, not :latest.
# PRIVATOOLS_IMAGE=ghcr.io/ethereaglehq/privatools@sha256:<approved-digest>
# GIT_SHA=<matching-full-commit-sha>
